scanner-tag-nosource = Tag ohne Datei
scanner-tag-broken = Tag für defekte Links
scanner-tag-duplicate = Tag für Duplikate
scanner-tag-nonfile = Tag für URL-Anhänge
pdf-oa-bridge-url = oa_pdf_search bridge URL
pdf-oa-bridge-help = Online sources call Kutuphane Python oa_pdf_search on this URL (default http://127.0.0.1:8756).
pdf-source-order = Priority order (comma-separated ids; enabled sources missing from this list are appended)
pdf-local-enabled =
    .label = Local folder — check on disk before downloading
pdf-local-folder = Folder path
pdf-watch-roots = Watched PDF roots
pdf-watch-roots-help = Add each root once, separated by semicolons. All subfolders are indexed automatically.
pdf-use-linked-base =
    .label = Also index Zotero linked attachment base directory
pdf-use-linked-base-help = Uses Advanced → Files and Folders → Linked Attachment Base Directory as an extra watch root (config-once).
pdf-local-aslink =
    .label = Attach as a link instead of copying into Zotero
pdf-doi-enabled =
    .label = DOI / Unpaywall (nur Metadaten — kein PDF-Download)
pdf-arxiv-enabled =
    .label = arXiv (nur Metadaten — kein PDF-Download)
pdf-pmc-enabled =
    .label = PubMed Central (Artikel)
pdf-s2-enabled =
