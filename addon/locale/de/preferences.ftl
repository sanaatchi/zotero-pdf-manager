pdf-show-report =
    .label = Show a download report tab after fetching PDFs

pdf-disk-audit-title = Disk- / Anhangsprüfung
pdf-disk-audit-help = Drei Aufgaben: verwaiste PDFs, Name↔Inhalt, Duplikate. Pro Zeile: Scannen → Bericht → Beheben.
pdf-disk-audit-flow-help = Zuerst scannen und Bericht lesen; Beheben fragt immer nach. Bei Trockenlauf schreibt Beheben nur einen Plan.
pdf-disk-audit-use-watch-roots =
    .label = Überwachte PDF-Wurzelverzeichnisse nutzen (pdf.watchRoots)
pdf-disk-audit-include-disinda =
    .label = _zotero_disinda einbeziehen (opt-in)
pdf-disk-audit-dry-run =
    .label = Trockenlauf / nur Plan (empfohlen)
pdf-disk-audit-dry-run-help = Wenn aktiv, verschiebt/benennt Beheben nicht um; Plan landet im Bericht. Wenn aus, nach Bestätigung anwenden.
pdf-disk-audit-bidir-heading = 0) Bidirektionale Prüfung (Eintrag ↔ PDF)
pdf-disk-audit-bidir-help = Ein Scan: von Zotero-Einträgen zu PDFs (fehlend/defekt/Typkonflikt) und von Disk-PDFs zu Einträgen (Waisen / gleiche Datei in anderem Ordner). Zuerst ausführen; die drei Zeilen darunter sind Detailkorrekturen.
pdf-disk-audit-bidir =
    .label = Scannen

pdf-disk-audit-orphan-heading = 1) Verwaiste PDFs
pdf-disk-audit-orphan-help = Auf der Festplatte, nicht in Zotero. Beheben: Einträge für DOI/ISBN/YÖK; Rest nach _pdf_quarantine/orphans.
pdf-disk-audit-orphan =
    .label = Scannen (Bericht)
pdf-disk-audit-orphan-apply =
    .label = Beheben: ID-Einträge + Rest quarantänisieren
pdf-disk-audit-name-heading = 2) Name ↔ Inhalt
pdf-disk-audit-name-help = Schlägt Umbenennungen vor bei Diskrepanz. Beheben nur clear_mismatch-Vorschläge.
pdf-disk-audit-name-content =
    .label = Scannen (Trockenlauf)
pdf-disk-audit-name-apply =
    .label = Beheben: vorgeschlagene Namen anwenden
pdf-disk-audit-copy-heading = 3) Doppelte PDFs
pdf-disk-audit-copy-help = Mehrere PDFs pro Eintrag oder Extra-Kopien im Ordner. Beheben: Verlierer nach _pdf_quarantine/copies (kein Löschen).
pdf-disk-audit-copy =
    .label = Scannen (Bericht)
pdf-disk-audit-copy-apply =
    .label = Beheben: Verlierer quarantänisieren
pdf-disk-audit-open-report =
    .label = Letzten Bericht öffnen
pdf-automation-title = Automatisierung (fehlende PDFs)
pdf-automation-help = PDFs mit Bibliothekseinträgen abgleichen. Getrennt von der Disk-Prüfung.
