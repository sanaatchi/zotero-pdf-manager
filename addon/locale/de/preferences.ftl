pdf-pdfkitap-enabled =
    .label = PDFKitap (Turkish books & articles)
pdf-dirzon-enabled =
    .label = Dirzon (books & articles)
pdf-yoktez-enabled =
    .label = YÖKTEZ (theses)
pdf-proquest-enabled =
