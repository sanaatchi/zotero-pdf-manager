# --- PDF downloader ---
pdf-pref-title = PDF Downloader
pdf-auto-on-startup =
    .label = Reconcile missing PDFs automatically when Zotero starts
pdf-auto-on-add =
    .label = Match a local PDF automatically when a Zotero item is added
pdf-periodic-minutes = Reconcile interval (minutes)
pdf-periodic-minutes-help = Use 0 to disable periodic reconciliation. Runs never overlap.
pdf-auto-attach-threshold = Auto-attach confidence (0–1)
pdf-review-threshold = Review-queue confidence (0–1)
pdf-match-threshold-help = Matches at or above auto-attach are linked automatically. Scores between review and auto-attach get #pdf-review. Below review is ignored.
pdf-add-settle-ms = Settle delay after new items (ms)
pdf-add-settle-ms-help = Coalesces rapid item additions before matching (Attanger-style debounce). Default 1000.
pdf-online-auto-download =
    .label = Automatically try open-access sources for newly added items
pdf-save-oa-to-downloads =
    .label = Save open-access PDFs under the first watch root’s downloads/ folder
pdf-save-oa-to-downloads-help = Keeps the disk folder as the authority (linked attachment). Sci-Hub and LibGen stay manual and are never part of automatic OA.
pdf-online-on-reconcile =
    .label = Also try open-access sources during startup and periodic scans
pdf-online-max-per-run = Maximum online lookups per bulk scan
pdf-online-safety-help = Automatic sources: Unpaywall (DOI), PMC and DergiPark. Sci-Hub, LibGen and proxies are never used automatically.
pdf-orphan-mode = PDFs without a Zotero item
pdf-orphan-auto-create =
    .label = Create items automatically
pdf-orphan-report =
    .label = Report only
pdf-orphan-off =
    .label = Ignore
pdf-orphan-max-per-run = Maximum new items per scan
pdf-orphan-help = Default is report-only. Opt-in auto-create on periodic scans only makes items when a DOI, ISBN, or YÖK thesis number is found. The manual button can still create filename-titled drafts for any orphan.
pdf-create-orphans =
    .label = Create Zotero items from orphan PDFs now
pdf-dry-run =
    .label = Dry-run (record plans without changing Zotero)
pdf-dry-run-help = Prevents attachment creation, tags, online requests and orphan item creation. Planned actions still appear in the audit report. Manual reconcile opens the audit when dry-run is on.
pdf-run-reconcile =
    .label = Run reconciliation now
pdf-cancel-reconcile =
    .label = Cancel running reconciliation
pdf-open-audit =
    .label = Open automation audit
pdf-clear-audit =
    .label = Clear audit log
pdf-clear-audit-done = Automation audit log cleared
pdf-audit-tags-help = Reversible tags: #auto-attached, #auto-oa, #pdf-review, #pdf-quarantine, #auto-created, #pdf-orphan — remove a tag in Zotero to undo that automation decision.
pdf-skip-existing =
    .label = Skip items that already have a PDF attachment
pdf-metadata-check =
